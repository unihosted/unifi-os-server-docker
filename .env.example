# UniFi OS Server Docker Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Your server's public IP address (required for UniFi OS to function)
# Example: UOS_SYSTEM_IP=192.168.1.100
UOS_SYSTEM_IP=

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Device UUID (auto-generated if not set)
# UOS_UUID=your-uuid-here

# Timezone
TZ=Europe/Amsterdam

# =============================================================================
# MONGODB CONFIGURATION
# =============================================================================

# MongoDB connection settings
MONGO_HOST=unifi-os-server-mongodb
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASS=root
MONGO_TLS=false
MONGO_AUTH_SOURCE=admin

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Firmware platform identifier (rarely needs changing)
# FIRMWARE_PLATFORM=linux-x64

# UniFi OS Server version (rarely needs changing)
# UOS_SERVER_VERSION=5.0.6
